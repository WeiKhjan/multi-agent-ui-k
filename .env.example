# Multi-Agent UI_K Configuration

# Server
PORT=3000
HOST=0.0.0.0

# Auth Mode: set to 'true' for local development (skips Cloudflare JWT validation)
DEV_MODE=true

# Dev mode default user (only used when DEV_MODE=true)
DEV_USER_EMAIL=dev@localhost
DEV_USER_NAME=Developer
DEV_USER_ROLE=owner

# Cloudflare Access (production)
CLOUDFLARE_TEAM_DOMAIN=your-team.cloudflareaccess.com
CLOUDFLARE_AUD=your-audience-tag

# Database
DB_PATH=./db/uik.sqlite

# Ollama (Vault agent — Mac 2 only)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_THINKING=qwen3:32b
OLLAMA_MODEL_FAST=qwen3:8b

# n8n (Mac 2 only)
N8N_WEBHOOK_BASE=http://localhost:5678

# Agent API Keys (generated during setup, shared between Mac 1 and Mac 2)
VAULT_AGENT_API_KEY=change-me-vault-key
BRAIN_AGENT_API_KEY=change-me-brain-key

# File storage root (Mac 2 only)
FILE_STORAGE_ROOT=./files
